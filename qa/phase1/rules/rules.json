{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["role", "status", "approved", "email"],
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Admin')",
        "role": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'Admin' || !data.exists()"
        }
      }
    },
    "shift_reports": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["gestor", "timestamp", "rol"]
    },
    "active_sessions": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["status", "lastHeartbeat", "gestor", "email"]
    },
    "login_history": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "login_logs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp", "email"]
    },
    "permissions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "logs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp", "gestor", "assignedTo", "status", "type"]
    },
    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["date", "author"]
    }
  }
}
